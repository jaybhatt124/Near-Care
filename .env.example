# NearCares — Environment Variables Template
SECRET_KEY=change-this-to-a-random-secret

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nearcares?retryWrites=true&w=majority

# Admin Panel Login
ADMIN_USER=admin
ADMIN_PASS=your_strong_password

# Google Maps API Key (primary) — https://console.cloud.google.com/
# Needs Places API + Geocoding API enabled
GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Mappls / MapmyIndia REST API Key (fallback) — https://www.mappls.com/api/
MAPPLS_API_KEY=your_mappls_api_key_here
